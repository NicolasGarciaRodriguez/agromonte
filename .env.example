# Crea una cuenta gratuita en https://formspree.io, crea un formulario y
# copia aquí su ID (el texto que aparece en la URL del endpoint, tipo
# https://formspree.io/f/xxxxxxx -> VITE_FORMSPREE_ID=xxxxxxx).
# Copia este archivo como .env y rellena el valor para activar el formulario
# de contacto de la landing.
VITE_FORMSPREE_ID=
